            <!-- Surefire plugin to run TestNG with testng.xml --> 
            <plugin>
            	<groupId>org.apache.maven.plugins</groupId>
            	<artifactId>maven-surefire-plugin</artifactId>
            	<version>3.0.0-M9</version>
            	<configuration>
            		<suiteXmlFiles>
            			<!-- Adjust path if testng.xml is inside resources -->
            			<suiteXmlFile>testng.xml</suiteXmlFile>
           			</suiteXmlFiles>
           			<systemPropertyVariables>
            			<headlessMode>${headless.mode}</headlessMode>
        			</systemPropertyVariables>
        		</configuration>
        	</plugin>
        </plugins>
    </build>
	
	<!-- A Maven profile allows you to switch between Headless (for CI/CD Jenkins) and GUI mode (for local debugging) without touching a single line of Java code -->
	<profiles>
	    <profile>
	        <id>gui</id>
	        <activation>
	            <activeByDefault>true</activeByDefault>
	        </activation>
	        <properties>
	            <headless.mode>false</headless.mode>
	        </properties>
	    </profile>

	    <profile>
	        <id>headless</id>
	        <properties>
	            <headless.mode>true</headless.mode>
	        </properties>
	    </profile>
	</profiles>
